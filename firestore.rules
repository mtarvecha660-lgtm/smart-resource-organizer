rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny rule to prevent unauthorized traversal
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint for connectivity validation
    match /test/{docId} {
      allow read: if true;
    }

    // Document-level user isolation for resources collection
    match /resources/{resourceId} {
      allow read: if request.auth != null && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid)
      );

      allow create: if request.auth != null && (
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid)
      );

      allow update: if request.auth != null && (
        ((resource.data.userId != null && resource.data.userId == request.auth.uid) ||
         (resource.data.uid != null && resource.data.uid == request.auth.uid)) &&
        ((request.resource.data.userId != null && request.resource.data.userId == request.auth.uid) ||
         (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid))
      );

      allow delete: if request.auth != null && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid)
      );
    }

    // User profile isolation
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
